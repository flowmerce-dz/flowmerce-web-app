# Flowmerce — secrets de l'environnement Docker local (docker-compose.dev.yml)
#
# Copier en `.env.docker.local` (ignoré par Git) et remplir chaque valeur.
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Valeurs PROPRES au local : ne jamais reprendre celles de la production.
# Les adresses (base, ML, SMTP, stockage) sont fixées dans
# docker-compose.dev.yml et n'ont rien à faire ici.

AUTH_SECRET=
NEXTAUTH_SECRET=
CRON_SECRET=

# Partagé entre `web` et `ml` (en-tête X-Internal-Key). 8 caractères minimum.
ML_INTERNAL_SECRET=

# Exigés par lib/env.ts mais jamais utilisés en local : les emails partent
# vers Mailpit (http://localhost:8025). Laisser ces valeurs factices.
GMAIL_USER=dev@flowmerce.local
GMAIL_APP_PASSWORD=mailpit-local-not-used

# Suivi des commandes : clé de chiffrement des secrets webhook. 32 caractères
# minimum. Facultative — sans elle, la génération de secrets est refusée.
ORDER_TRACKING_SECRET_KEY=change-me-32-characters-minimum-local-only
