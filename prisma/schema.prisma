generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(VENDOR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
  sessions  Session[]
  vendor    Vendor?

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vendor {
  id                 String         @id @default(cuid())
  userId             String         @unique
  companyName        String
  phone              String
  address            String
  website            String?
  status             VendorStatus   @default(PENDING)
  rejectionReason    String?
  requestedDocuments DocumentType[] @default([])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  vendorCategories   String[]       @default([])

  // ── Services activés ──────────────────────────────────────────────────────
  // Deux services indépendants : l'activation de l'un ne dit rien de l'autre,
  // et aucun ne dépend de la configuration de l'autre (ReturnPolicy pour
  // Retours-ML, OrderTrackingConfig pour le suivi).
  //
  // `returnsMLEnabled` vaut `true` par défaut : c'était le comportement
  // implicite avant l'introduction des services, et les boutiques existantes
  // ne doivent rien voir changer. Le suivi, lui, s'active explicitement.
  returnsMLEnabled     Boolean @default(true)
  orderTrackingEnabled Boolean @default(false)

  apiKeys            ApiKey[]
  claims             Claim[]
  documents          Document[]
  returnPolicy       ReturnPolicy?
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Service de suivi des commandes (lib/order-tracking).
  orderTrackingConfig OrderTrackingConfig?
  orders              Order[]
  orderStatusEvents   OrderStatusEvent[]
  statusMappings      StoreStatusMapping[]
  notificationJobs    NotificationJob[]
  webhookLogs         WebhookLog[]

  @@index([status])
}

model Document {
  id              String         @id @default(cuid())
  vendorId        String
  name            String
  storagePath     String
  type            DocumentType
  status          DocumentStatus
  rejectionReason String?
  createdAt       DateTime       @default(now())
  vendor          Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model ReturnPolicy {
  id                      String         @id @default(cuid())
  vendorId                String         @unique
  allowRefusalOnDelivery  Boolean        @default(false)
  maxClaimDays            Int            @default(14)
  acceptedTypes           ClaimType[]
  validationMode          ValidationMode @default(MANUAL)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  fraudScoreThreshold     Int            @default(70)
  fraudReturnThreshold    Int            @default(4)
  acceptedReturnReasons   String[]       @default([])
  exchangeOnlyCategories  String[]       @default([])
  nonRefundableCategories String[]       @default([])
  partialRefundEnabled    Boolean        @default(false)
  partialRefundRules      Json?
  processingDays          Int            @default(5)
  vendor                  Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id             String          @id @default(cuid())
  vendorId       String
  name           String
  key            String          @unique
  isActive       Boolean         @default(true)
  lastUsedAt     DateTime?
  createdAt      DateTime        @default(now())
  keyPrefix      String?
  vendor         Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  returnSessions ReturnSession[]

  @@index([vendorId])
  @@index([key])
}

model ReturnSession {
  id              String    @id @default(cuid())
  token           String    @unique
  vendorId        String
  orderId         String
  customerId      String?
  customerEmail   String
  productName     String
  customerName    String
  customerPhone   String    @default("")
  customerWilaya  String?
  customerAge     Int?
  customerGender  String?
  paymentMethod   String?
  shippingMethod  String?
  shippingCost    Float?
  orderDate       String    @default("")
  shopName        String    @default("")
  productPrice    Float?
  productQuantity Int?
  orderTotal      Float?
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  vendor          ApiKey    @relation(fields: [vendorId], references: [id])
}

model Claim {
  id            String      @id @default(cuid())
  vendorId      String
  apiKeyId      String?
  orderId       String
  customerId    String?
  customerName  String
  customerEmail String
  customerPhone String?
  type          ClaimType?
  description   String
  status        ClaimStatus @default(PENDING)
  aiScore       Float?
  aiDecision    String?
  prediction    Json?
  processedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  productName   String?
  orderDate     DateTime?
  source        ClaimSource @default(API)
  fraudScore    Float?
  ipAddress     String?
  mlFailed      Boolean     @default(false)
  mlAttempts    Int         @default(0)
  mlInput       Json?
  exportedToML  Boolean     @default(false)
  exportedAt    DateTime?

  // ── Origine de `aiDecision` — prédiction ≠ vérité terrain (C-04) ──────────
  // `aiDecision` porte la décision effective sur la réclamation. Sans
  // qualification de son origine, une recommandation du modèle appliquée
  // automatiquement redevenait un label d'entraînement au cycle suivant : le
  // modèle se réentraînait sur ses propres sorties.
  //
  //   MODEL       recommandation du modèle (ingestion ou reprise cron)
  //   POLICY_RULE refus déterministe par la politique de retour du vendeur
  //   HUMAN       décision explicite d'un vendeur ou d'un admin
  //
  // Seuls POLICY_RULE et HUMAN sont exportables comme vérité terrain.
  resolutionSource DecisionSource?
  // Auteur et date de la décision humaine, quand il y en a une.
  resolvedBy       String?
  resolvedAt       DateTime?
  // Réclamation hors politique vendeur (délai dépassé, catégorie exclue…).
  // Refusée d'office sans passer par le ML et masquée au vendeur : il n'a
  // rien à trancher. Reste visible côté admin et exportable vers le dataset.
  policyRejected   Boolean         @default(false)

  // ── Consentement du client final (RGPD / loi 18-07) ───────────────────────
  // Horodatage de l'acceptation explicite du traitement des données de la
  // demande : décision sur la réclamation, entraînement du modèle et
  // rapprochement avec les retours précédents. Exigé sur les deux canaux de
  // soumission — portail hébergé et formulaire embarqué chez la boutique.
  //
  // Nullable pour une seule raison : les réclamations créées avant la mise en
  // place n'ont pas de trace, et rien ne justifie de leur en inventer une. Sur
  // une réclamation postérieure, une valeur nulle est un signal — la soumission
  // n'aurait pas dû passer.
  dataConsentAt DateTime?

  // ── Motif de retour, en trois données distinctes ──────────────────────────
  // `returnReason` : motif principal, valeur exacte de RETURN_REASONS — la même
  // que celle envoyée au ML dans Return_Reason (le ML n'en voit aucune autre).
  // `returnReasonDetail` : code de la sous-raison (RETURN_REASON_DETAILS),
  // toujours rattachée à `returnReason`. Jamais envoyée au ML.
  // `returnReasonComment` : précision libre du client, facultative.
  //
  // Nullables : les réclamations antérieures n'ont pas de sous-raison, et rien
  // ne justifie de leur en attribuer une. Leur motif principal a été repris de
  // `mlInput.Return_Reason` à la migration.
  returnReason        String?
  returnReasonDetail  String?
  returnReasonComment String?

  // ── Identification du produit (analyses des retours) ──────────────────────
  // `productId` : identifiant transmis par la boutique (API v1). `productKey` :
  // clé de regroupement des analyses — `id:<productId>` quand il est connu,
  // sinon `name:<nom normalisé>` (cf. lib/services/product-issues.ts).
  productId  String?
  productKey String?

  // Ajustement du score de fraude quand des retours précédents du client
  // s'expliquent par un problème collectif sur un produit. Trace complète :
  // score brut, score ajusté, retours neutralisés et règle appliquée.
  fraudAdjustment Json?

  vendor         Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  decisionEvents ClaimDecisionEvent[]

  @@unique([vendorId, orderId])
  @@index([vendorId, productKey])
  @@index([vendorId, createdAt(sort: Desc)])
  @@index([vendorId, status])
  @@index([vendorId, policyRejected])
  @@index([vendorId])
  @@index([status])
  @@index([orderId])
  @@index([mlFailed])
  @@index([exportedToML, resolutionSource])
}

// Historique des décisions d'une réclamation — en ajout seul (audit RS-01).
//
// Chaque changement de statut y laisse une ligne : statut et résolution avant
// et après, auteur, origine et motif. Une ligne n'est jamais modifiée : un
// déclencheur PostgreSQL refuse tout UPDATE (migration
// 20261113150000_claim_decision_history). La suppression reste possible
// uniquement en cascade, quand la réclamation elle-même est supprimée.
model ClaimDecisionEvent {
  id               String       @id @default(cuid())
  claimId          String
  // NULL : la décision a été prise à la création de la réclamation (refus
  // d'office par la politique de retour).
  previousStatus   ClaimStatus?
  newStatus        ClaimStatus
  previousDecision String?
  newDecision      String?
  // VENDOR, ADMIN ou SYSTEM.
  actorType        String
  // E-mail ou identifiant de l'utilisateur ; pour SYSTEM, la règle appliquée.
  actor            String
  // dashboard, auto_on_create, validation_mode, policy, admin_amendment.
  origin           String
  reason           String?
  createdAt        DateTime     @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
}

model PredictionLog {
  id        String   @id @default(cuid())
  claimId   String?
  vendorId  String
  input     Json
  output    Json
  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([claimId])
}

model ReturnRateLimit {
  id      String   @id @default(cuid())
  key     String   @unique
  count   Int      @default(1)
  resetAt DateTime

  @@index([key])
  @@index([resetAt])
}

model CustomerFraudRecord {
  id              String    @id @default(cuid())
  customerEmail   String?
  customerPhone   String?
  totalClaims     Int       @default(0)
  totalRefusals   Int       @default(0)
  distinctVendors Int       @default(0)
  lastClaimAt     DateTime?
  lastRefusalAt   DateTime?
  matchedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([customerEmail])
  @@index([customerPhone])
}

model RefusalReport {
  id            String   @id @default(cuid())
  vendorId      String
  customerEmail String?
  customerPhone String?
  orderId       String
  claimId       String?
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([vendorId, orderId])
  @@index([vendorId])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([createdAt])
}

// ═════════════════════════════════════════════════════════════════════════════
//  Service de suivi des commandes (Order Tracking)
//
//  Module indépendant de Retours-ML : aucun de ces modèles ne référence une
//  réclamation, une politique de retour ou une prédiction. La boutique est le
//  `Vendor` existant — il n'y a pas de second modèle de boutique.
// ═════════════════════════════════════════════════════════════════════════════

// Paramètres du suivi propres à une boutique. Créée à la première
// configuration ; son absence ne bloque rien d'autre que la réception des
// webhooks (pas de secret → pas de signature vérifiable).
model OrderTrackingConfig {
  id       String @id @default(cuid())
  vendorId String @unique

  // Secret de signature des webhooks, chiffré en AES-256-GCM
  // (lib/order-tracking/crypto.ts). Il ne peut pas être haché comme une clé
  // API : le HMAC se recalcule avec la valeur en clair. Elle n'est rendue au
  // vendeur qu'une fois, à la génération ; seul le préfixe reste affichable.
  webhookSecretEnc       String?
  webhookSecretPrefix    String?
  webhookSecretCreatedAt DateTime?

  // Source des changements de statut. Une seule est active à la fois : deux
  // sources simultanées annonceraient deux fois le même changement au client.
  //   WEBHOOK    la boutique envoie chaque changement à Flowmerce ;
  //   POLLING    Flowmerce interroge une URL de la boutique à intervalle régulier ;
  //   CONNECTOR  Flowmerce lit les statuts chez un service tiers
  //              (lib/order-tracking/connectors.ts).
  integrationMode TrackingIntegrationMode @default(WEBHOOK)

  // Polling. Le jeton envoyé à la boutique est chiffré comme le secret webhook
  // et n'est jamais renvoyé au tableau de bord.
  pollingUrl      String?
  pollingTokenEnc String?
  // Connecteur choisi et ses identifiants (JSON chiffré).
  connectorId             String?
  connectorCredentialsEnc String?

  // État de la synchronisation, commun au polling et aux connecteurs.
  // `pullStartedAt` : moment où la source a été branchée. Un changement
  // antérieur est enregistré mais n'est jamais annoncé au client — une première
  // synchronisation ne doit pas réexpédier l'historique de la boutique.
  pullStartedAt  DateTime?
  pullCursor     String?
  // Posé pendant une synchronisation ; un verrou trop ancien est repris.
  pullLockedAt   DateTime?
  pullLastRunAt  DateTime?
  pullLastOk     Boolean?
  pullLastError  String?
  pullLastEvents Int?

  // Statuts de commande qui existent dans la boutique, tels qu'elle les a
  // déclarés (PUT /api/v1/order-statuses) : ses propres libellés, pas des
  // statuts normalisés. Le tableau de bord ne présente au vendeur que ceux-là.
  // Vide : la boutique n'a rien déclaré, tous les statuts standards sont
  // proposés.
  storeStatuses           String[]  @default([])
  storeStatusesDeclaredAt DateTime?

  // Statuts normalisés qui déclenchent une notification au client.
  notifyStatuses      OrderStatus[]       @default([])
  notificationChannel NotificationChannel @default(EMAIL)
  // Langue des messages quand le webhook n'en précise pas : 'fr' ou 'ar'.
  defaultLanguage     String              @default("fr")
  // Messages personnalisés : { [OrderStatus]: { fr?: {subject, body}, ar?: … } }.
  // Absent ou incomplet → modèles par défaut (lib/order-tracking/templates.ts).
  messageTemplates    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

// Commande suivie. Identifiée par la boutique et son identifiant externe : une
// commande n'existe jamais deux fois pour une même boutique.
model Order {
  id         String @id @default(cuid())
  vendorId   String
  externalId String

  // Statut courant, normalisé. Ne régresse jamais : seul un événement plus
  // récent que `statusUpdatedAt` peut le remplacer.
  status          OrderStatus @default(UNMAPPED)
  // Statut tel que la boutique l'a transmis pour l'événement courant.
  rawStatus       String
  // `updated_at` de l'événement qui a fixé le statut courant.
  statusUpdatedAt DateTime

  customerName     String?
  customerEmail    String?
  customerPhone    String?
  // Langue du client transmise par la boutique ('fr' / 'ar'), si connue.
  customerLanguage String?

  trackingNumber String?
  carrier        String?
  trackingUrl    String?
  items          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor           Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  events           OrderStatusEvent[]
  notificationJobs NotificationJob[]

  @@unique([vendorId, externalId])
  @@index([vendorId, status])
  @@index([vendorId, updatedAt(sort: Desc)])
}

// Historique des changements de statut — une ligne par événement reçu, y
// compris ceux arrivés en retard, qui sont conservés sans être appliqués.
model OrderStatusEvent {
  id       String @id @default(cuid())
  vendorId String
  orderId  String
  // Identifiant de l'événement fourni par la boutique (X-Flowmerce-Event-Id).
  // Unique par boutique : c'est la garantie d'idempotence du webhook.
  eventId  String

  status     OrderStatus
  rawStatus  String
  // Date du changement côté boutique (`updated_at` du corps).
  occurredAt DateTime
  receivedAt DateTime @default(now())
  // `false` : événement conservé pour l'historique mais sans effet sur le
  // statut courant (arrivé en retard, ou statut non reconnu).
  applied    Boolean  @default(true)

  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  notificationJob NotificationJob?

  @@unique([vendorId, eventId])
  @@index([orderId, occurredAt])
  @@index([vendorId, status])
}

// Correspondance entre un statut propre à la boutique et un statut normalisé.
// Complète les correspondances par défaut et prime sur elles.
model StoreStatusMapping {
  id             String      @id @default(cuid())
  vendorId       String
  // Libellé tel que saisi ou reçu, pour l'affichage.
  externalStatus String
  // Clé de comparaison : minuscules, sans accents ni ponctuation.
  normalizedKey  String
  status         OrderStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, normalizedKey])
}

// File d'envoi des notifications. Jamais d'envoi dans la requête du webhook :
// le travail est créé dans la même transaction que l'événement, puis pris en
// charge par le worker (lib/order-tracking/worker.ts).
model NotificationJob {
  id       String @id @default(cuid())
  vendorId String
  orderId  String
  // Un événement ne produit jamais plus d'une notification.
  eventId  String @unique

  channel     NotificationChannel
  status      NotificationJobStatus @default(PENDING)
  orderStatus OrderStatus
  recipient   String
  language    String                @default("fr")

  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  nextAttemptAt DateTime  @default(now())
  // Posé à la prise en charge par un worker ; un verrou trop ancien est
  // considéré comme abandonné et le travail est repris.
  lockedAt      DateTime?
  lastError     String?
  sentAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  order  Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event  OrderStatusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([vendorId, createdAt(sort: Desc)])
}

// Journal des webhooks reçus pour une boutique identifiée, acceptés ou non.
// Ne contient ni le corps de la requête ni de donnée client.
model WebhookLog {
  id       String @id @default(cuid())
  vendorId String

  eventId         String?
  externalOrderId String?
  rawStatus       String?
  // Mode d'intégration par lequel la ligne est arrivée.
  source     TrackingIntegrationMode @default(WEBHOOK)
  // PROCESSED, STALE, UNMAPPED, DUPLICATE, INVALID_SIGNATURE,
  // INVALID_TIMESTAMP, INVALID_PAYLOAD, NOT_CONFIGURED, TEST_OK, ERROR,
  // WRONG_MODE (webhook reçu alors qu'une autre source est active),
  // PULL_ERROR (synchronisation en échec : `httpStatus` est la réponse de la
  // boutique, ou 0 si elle n'a pas répondu).
  outcome    String
  httpStatus Int
  error      String?
  // Webhook de test envoyé depuis le tableau de bord : n'écrit aucune commande.
  isTest     Boolean  @default(false)
  durationMs Int?
  receivedAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, receivedAt(sort: Desc)])
}

enum Role {
  ADMIN
  VENDOR
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  DOCUMENTS_REQUESTED
}

enum DocumentType {
  ID_CARD
  BUSINESS_REGISTRATION
  ADDRESS_PROOF
  TAX_CERTIFICATE
  BANK_DETAILS
  OTHER
}

enum DocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ValidationMode {
  MANUAL
  AI_AUTO
}

enum ClaimType {
  EXCHANGE
  REFUND
  REPAIR
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
}

enum ClaimSource {
  API
  HOSTED_PAGE
}

// Origine d'une décision portée par `Claim.aiDecision`.
// Voir le commentaire de `Claim.resolutionSource`.
enum DecisionSource {
  MODEL
  POLICY_RULE
  HUMAN
}

// Statuts normalisés d'une commande suivie.
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
  // Statut transmis par la boutique sans correspondance connue.
  UNMAPPED
}

enum NotificationChannel {
  EMAIL
  // Prévu, sans fournisseur branché pour l'instant.
  WHATSAPP
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// Mode d'intégration du suivi des commandes : d'où viennent les statuts.
enum TrackingIntegrationMode {
  WEBHOOK
  POLLING
  CONNECTOR
}
